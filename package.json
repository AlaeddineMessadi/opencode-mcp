{
  "name": "opencode-mcp",
  "version": "3.0.0",
  "description": "MCP server for OpenCode coding workflows, durable async jobs, project resources, and explicit user input",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "opencode-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "docs:generate": "npm run build && node scripts/generate-tool-docs.mjs",
    "docs:check": "npm run build && node scripts/generate-tool-docs.mjs --check"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "opencode",
    "ai",
    "llm",
    "claude",
    "cursor",
    "windsurf",
    "coding-assistant",
    "headless",
    "server",
    "tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlaeddineMessadi/opencode-mcp.git"
  },
  "homepage": "https://github.com/AlaeddineMessadi/opencode-mcp#readme",
  "bugs": {
    "url": "https://github.com/AlaeddineMessadi/opencode-mcp/issues"
  },
  "author": "Alaeddine Messadi",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@opencode-ai/sdk": "^1.18.31",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
